{"author":"Muse","bugs":{"url":"https://github.com/nemesisqp/bun-rusty-mp3/issues"},"description":"Personal test project (not production ready): Bun/Node bindings to rusty_mp3 — a pure-Rust MP3 codec by Mata Network and the Remade-With-Rust team, faster to encode than lamejs. Drop-in replacement for @breezystack/lamejs (by Alex Zhukov / breezygideon).","devDependencies":{"@breezystack/lamejs":"^1.2.7","@napi-rs/cli":"^3.10.12","@types/node":"^26.6.6","typescript":"^5.9.0"},"engines":{"bun":">=1.3","node":">=18"},"exports":{".":{"default":"./index.js","types":"./index.d.ts"}},"files":["index.js","index.d.ts","binding.js","lib/","scripts/check-prebuilt.js","LICENSE","README.md","CHANGELOG.md"],"homepage":"https://github.com/nemesisqp/bun-rusty-mp3","keywords":["mp3","audio","codec","bun","napi","rust","lamejs","encoder"],"license":"MIT","main":"index.js","name":"@ndqp/bun-rusty-mp3","napi":{"binaryName":"bun-rusty-mp3","packageName":"@ndqp/bun-rusty-mp3","targets":["aarch64-apple-darwin","x86_64-pc-windows-msvc","aarch64-pc-windows-msvc","x86_64-unknown-linux-gnu","x86_64-unknown-linux-musl","aarch64-unknown-linux-gnu","aarch64-unknown-linux-musl"]},"repository":{"type":"git","url":"git+https://github.com/nemesisqp/bun-rusty-mp3.git"},"scripts":{"bench":"bun bench/bench.mjs","build":"napi build --platform --release --js binding.js --dts lib/binding.d.ts","build:debug":"napi build --platform --js binding.js --dts lib/binding.d.ts","build:local":"bash scripts/build-local.sh","clippy":"cargo clippy --all-targets -- -D warnings","fmt":"cargo fmt --check","fmt:fix":"cargo fmt","postinstall":"node scripts/check-prebuilt.js","release:prepare":"napi create-npm-dirs && napi prepublish","test":"node --test test/*.test.mjs","test:bun":"bun test test/","typecheck":"tsc --noEmit -p tsconfig.json"},"types":"index.d.ts","version":"0.1.1"}